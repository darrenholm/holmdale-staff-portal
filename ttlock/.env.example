# Copy to ttlock/.env and fill in. Never commit the real file.

# --- TTLock Open Platform (open.ttlock.com -> your application) -------------
TTLOCK_CLIENT_ID=
TTLOCK_CLIENT_SECRET=

# The TTLock *app* account that owns the locks.
TTLOCK_USERNAME=
# Either the plaintext account password or its lowercase MD5 hash --
# the server hashes plaintext for you, so the hash is the safer thing to store.
TTLOCK_PASSWORD=

# api.ttlock.com (default, North America/global) or euapi.ttlock.com (EU accounts).
# TTLOCK_BASE_URL=https://api.ttlock.com

# --- This service ----------------------------------------------------------
# Password front-desk staff type to open the tool.
STAFF_PASSWORD=

# Signs session tokens. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, a random one is generated at boot and every restart logs everyone out.
SESSION_SECRET=

PORT=8080
SESSION_HOURS=12

# House check-in / check-out hours, 24h clock. TTLock only honours whole hours.
CHECKIN_HOUR=15
CHECKOUT_HOUR=11

# Only needed if the UI is served from a different origin than this service.
# ALLOWED_ORIGINS=https://rooms.walkertonlivery.ca
