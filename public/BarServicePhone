<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Bar Service - Holmdale Pro Rodeo</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: #1a1a1a;
            min-height: 100vh;
            color: #fff;
            padding-bottom: env(safe-area-inset-bottom);
        }

        /* HEADER */
        .header {
            background: #111;
            padding: 12px 16px;
            border-bottom: 2px solid #00B74A;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 100;
        }
        .header-left h1 { color: #00B74A; font-size: 18px; font-weight: 800; line-height: 1; }
        .header-left p { color: #888; font-size: 12px; margin-top: 2px; }
        .stat-box { background: #00B74A; color: white; padding: 6px 12px; border-radius: 20px; font-size: 13px; font-weight: 700; }

        /* MAIN CONTENT */
        .content { padding: 12px 16px; }

        /* ALERT */
        .alert { padding: 14px 16px; border-radius: 10px; margin-bottom: 12px; font-weight: 600; font-size: 15px; text-align: center; }
        .alert-success { background: #065f46; color: #6ee7b7; border: 2px solid #00B74A; }
        .alert-error { background: #7f1d1d; color: #fca5a5; border: 2px solid #ef4444; }
        .alert-warning { background: #78350f; color: #fcd34d; border: 2px solid #f59e0b; }

        /* SCAN CARD */
        .card { background: #242424; border-radius: 14px; padding: 16px; margin-bottom: 12px; }

        .scan-mode-toggle { display: flex; gap: 8px; margin-bottom: 14px; }
        .scan-mode-toggle button {
            flex: 1; padding: 12px 8px;
            border: 2px solid #333; background: #1a1a1a;
            border-radius: 10px; font-weight: 700; cursor: pointer;
            font-size: 15px; color: #888; transition: all 0.2s;
        }
        .scan-mode-toggle button.active { background: #00B74A; color: white; border-color: #00B74A; }

        .nfc-box {
            background: #1a1a1a;
            border: 2px solid #00B74A;
            border-radius: 12px;
            padding: 28px 20px;
            text-align: center;
        }
        .nfc-box .nfc-icon { font-size: 48px; margin-bottom: 10px; animation: pulse 2s infinite; }
        .nfc-box h3 { color: #00B74A; font-size: 20px; margin-bottom: 6px; }
        .nfc-box p { color: #888; font-size: 14px; }
        @keyframes pulse { 0%,100% { opacity: 1; } 50% { opacity: 0.6; } }

        .input-group { margin-bottom: 12px; }
        .input-group label { display: block; margin-bottom: 6px; color: #aaa; font-weight: 600; font-size: 13px; text-transform: uppercase; letter-spacing: 0.5px; }
        .input-group input {
            width: 100%; padding: 16px;
            border: 2px solid #333; border-radius: 10px;
            font-size: 18px; font-weight: 600;
            background: #1a1a1a; color: #fff;
        }
        .input-group input:focus { outline: none; border-color: #00B74A; }
        .input-group input::placeholder { color: #555; }

        .search-results {
            background: #1a1a1a;
            border: 2px solid #333;
            border-radius: 10px;
            margin-top: 8px;
            max-height: 280px;
            overflow-y: auto;
        }
        .search-result-item {
            padding: 14px 16px;
            border-bottom: 1px solid #2a2a2a;
            cursor: pointer;
            active: background: #2a2a2a;
        }
        .search-result-item:last-child { border-bottom: none; }
        .search-result-item:active { background: #2a2a2a; }
        .search-result-name { font-weight: 700; color: #fff; font-size: 17px; margin-bottom: 3px; }
        .search-result-details { color: #888; font-size: 13px; }

        /* CUSTOMER CARD */
        .customer-header {
            display: flex;
            align-items: flex-start;
            gap: 12px;
            margin-bottom: 12px;
        }
        .customer-info-block { flex: 1; }
        .customer-name { color: #00B74A; font-size: 22px; font-weight: 800; line-height: 1.2; margin-bottom: 4px; }
        .customer-meta { color: #888; font-size: 13px; margin-bottom: 4px; }
        .age-badge {
            display: inline-block; padding: 4px 10px;
            border-radius: 20px; font-size: 12px; font-weight: 700;
        }
        .age-ok { background: #065f46; color: #6ee7b7; }
        .age-no { background: #7f1d1d; color: #fca5a5; }

        .done-btn {
            background: #FFD700;
            color: #000;
            border: none;
            border-radius: 12px;
            padding: 14px 18px;
            font-size: 16px;
            font-weight: 800;
            cursor: pointer;
            white-space: nowrap;
            flex-shrink: 0;
            min-height: 70px;
        }
        .done-btn:active { opacity: 0.8; }

        /* BALANCE */
        .balance-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: #1a1a1a;
            border-radius: 12px;
            padding: 16px;
            margin-bottom: 12px;
            border: 2px solid #00B74A;
        }
        .balance-num { font-size: 52px; font-weight: 800; color: #00B74A; line-height: 1; }
        .balance-label { color: #888; font-size: 13px; margin-top: 2px; }

        /* TRANSACTIONS */
        .transactions { background: #1a1a1a; border-radius: 10px; padding: 12px; margin-bottom: 12px; border-left: 3px solid #f59e0b; }
        .transactions h4 { color: #f59e0b; font-size: 13px; margin-bottom: 8px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; }
        .transaction-item { display: flex; justify-content: space-between; align-items: center; padding: 8px 10px; background: #242424; border-radius: 8px; margin-bottom: 6px; }
        .transaction-item:last-child { margin-bottom: 0; }
        .transaction-info { flex: 1; font-size: 14px; color: #ddd; }
        .transaction-time { font-size: 11px; color: #666; }
        .btn-cancel { background: #7f1d1d; color: #fca5a5; border: 1px solid #ef4444; padding: 6px 14px; border-radius: 6px; font-size: 13px; font-weight: 700; cursor: pointer; }
        .btn-cancel:active { opacity: 0.8; }

        /* DRINK GRID */
        .drink-section-title { color: #aaa; font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 10px; }
        .drink-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 12px; }
        .drink-btn {
            background: #00B74A;
            color: white; border: none;
            padding: 20px 12px;
            border-radius: 12px;
            font-size: 16px; font-weight: 700;
            cursor: pointer; transition: all 0.15s;
            position: relative; text-align: center;
            min-height: 80px;
            display: flex; flex-direction: column;
            align-items: center; justify-content: center;
        }
        .drink-btn:active { transform: scale(0.96); background: #009639; }
        .drink-btn:disabled { background: #2a2a2a; color: #555; cursor: not-allowed; }
        .drink-btn .drink-name { display: block; line-height: 1.2; }
        .drink-counter {
            position: absolute; top: 6px; right: 6px;
            background: #dc2626; color: white;
            border-radius: 50%; width: 24px; height: 24px;
            display: flex; align-items: center; justify-content: center;
            font-size: 13px; font-weight: 800;
        }

        .hidden { display: none !important; }
        .no-drinks { grid-column: 1/-1; text-align: center; padding: 30px; color: #555; font-size: 15px; }
    </style>
</head>
<body>

    <div class="header">
        <div class="header-left">
            <h1>🍺 BAR SERVICE</h1>
            <p>Holmdale Pro Rodeo</p>
        </div>
        <div class="stat-box" id="servedCount">0 Served</div>
    </div>

    <div class="content">
        <div id="alertContainer"></div>

        <!-- SCAN CARD -->
        <div id="scanCard" class="card">
            <div class="scan-mode-toggle">
                <button id="nfcBtn" class="active" onclick="switchToNFC()">📱 NFC Scan</button>
                <button id="nameBtn" onclick="switchToName()">👤 Name Search</button>
            </div>

            <div id="nfcMode">
                <div class="nfc-box">
                    <div class="nfc-icon">📳</div>
                    <h3>Tap Wristband</h3>
                    <p>Hold wristband to the back of the phone</p>
                </div>
            </div>

            <div id="nameMode" class="hidden">
                <div class="input-group">
                    <label>Customer Name</label>
                    <input type="text" id="customerName" placeholder="Start typing..." autocomplete="off">
                </div>
                <div id="searchResults" class="hidden"></div>
            </div>
        </div>

        <!-- CUSTOMER CARD -->
        <div id="customerCard" class="hidden">

            <div class="card">
                <div class="customer-header">
                    <div class="customer-info-block">
                        <div class="customer-name" id="customerNameDisplay"></div>
                        <div class="customer-meta" id="wristbandDisplay"></div>
                        <span id="ageStatus"></span>
                    </div>
                    <button class="done-btn" onclick="reset()">✓<br>DONE</button>
                </div>

                <div class="balance-row">
                    <div>
                        <div class="balance-num" id="balanceAmount">0</div>
                        <div class="balance-label">Tickets Available</div>
                    </div>
                </div>
            </div>

            <div id="transactionsContainer" class="transactions hidden">
                <h4>Recent — tap to cancel:</h4>
                <div id="transactionsList"></div>
            </div>

            <div class="card">
                <div class="drink-section-title">Select Drink</div>
                <div class="drink-grid" id="drinkGrid"></div>
            </div>

        </div>
    </div>

    <script>
        const API = 'https://rodeo-fresh-production-7348.up.railway.app/api';
        let token = '';
        let currentBand = null;
        let drinks = [];
        let servedCount = 0;
        let recentTransactions = [];
        let nfcReader = null;
        let isProcessing = false;
        let currentMode = 'nfc';
        let allWristbands = [];

        function normalizeUid(uid) {
            const cleaned = uid.replace(/[^a-fA-F0-9]/g, '').toUpperCase();
            const bytes = cleaned.match(/.{2}/g);
            return bytes ? bytes.sort().join('') : cleaned;
        }

        window.onload = async function() {
            token = localStorage.getItem('auth_token');
            if (!token) { window.location.href = 'login.html'; return; }
            await loadDrinks();
            await loadAllWristbands();
            loadServedCount();

            // Wire up name search AFTER wristbands are loaded
            document.getElementById('customerName').addEventListener('input', function() {
                const query = this.value.trim().toLowerCase();
                const resultsDiv = document.getElementById('searchResults');
                if (query.length < 2) { resultsDiv.classList.add('hidden'); return; }
                const matches = allWristbands.filter(b => (b.customer_name || '').toLowerCase().includes(query));
                displaySearchResults(matches);
            });

            if ('NDEFReader' in window) {
                startNFC();
            } else {
                switchToName();
                showMessage('⚠️ NFC not supported — using name search', 'warning');
            }
        };

        async function loadAllWristbands() {
            try {
                const r = await fetch(API + '/wristbands', { headers: {'Authorization': 'Bearer ' + token} });
                if (r.ok) {
                    allWristbands = await r.json();
                    console.log('Loaded', allWristbands.length, 'wristbands');
                }
            } catch(err) { console.error('Error loading wristbands:', err); }
        }

        async function startNFC() {
            if (currentMode !== 'nfc') return;
            try {
                nfcReader = new NDEFReader();
                nfcReader.onreading = async (event) => {
                    if (isProcessing) return;
                    isProcessing = true;
                    const uid = normalizeUid(event.serialNumber);
                    await lookupWristband(uid);
                    setTimeout(() => { isProcessing = false; }, 1000);
                };
                await nfcReader.scan();
            } catch(err) {
                console.error('NFC error:', err);
                switchToName();
                showMessage('⚠️ NFC unavailable — using name search', 'warning');
            }
        }

        function stopNFC() {
            if (nfcReader) { try { nfcReader.onreading = null; nfcReader = null; } catch(e) {} }
            isProcessing = false;
        }

        function switchToNFC() {
            if (!('NDEFReader' in window)) { showMessage('❌ NFC not supported on this device', 'error'); return; }
            currentMode = 'nfc';
            document.getElementById('nfcMode').classList.remove('hidden');
            document.getElementById('nameMode').classList.add('hidden');
            document.getElementById('nfcBtn').classList.add('active');
            document.getElementById('nameBtn').classList.remove('active');
            stopNFC();
            setTimeout(() => startNFC(), 100);
        }

        function switchToName() {
            currentMode = 'name';
            document.getElementById('nfcMode').classList.add('hidden');
            document.getElementById('nameMode').classList.remove('hidden');
            document.getElementById('nfcBtn').classList.remove('active');
            document.getElementById('nameBtn').classList.add('active');
            stopNFC();
            setTimeout(() => document.getElementById('customerName').focus(), 100);
        }

        function displaySearchResults(matches) {
            const resultsDiv = document.getElementById('searchResults');
            if (matches.length === 0) {
                resultsDiv.innerHTML = '<div style="padding:16px;text-align:center;color:#555;">No customers found</div>';
                resultsDiv.classList.remove('hidden');
                return;
            }
            resultsDiv.innerHTML = '<div class="search-results">' + matches.slice(0, 10).map(band => {
                const tickets = Math.floor((band.credits || 0) / 7);
                const age = band.alcohol_approved ? '✓ 19+' : '✗ Not verified';
                return `<div class="search-result-item" onclick="selectCustomer('${band.rfid_uid}')">
                    <div class="search-result-name">${band.customer_name || 'Unknown'}</div>
                    <div class="search-result-details">${tickets} ticket${tickets !== 1 ? 's' : ''} · ${age}</div>
                </div>`;
            }).join('') + '</div>';
            resultsDiv.classList.remove('hidden');
        }

        async function selectCustomer(uid) {
            if (isProcessing) return;
            isProcessing = true;
            document.getElementById('searchResults').classList.add('hidden');
            document.getElementById('customerName').value = '';
            await lookupWristband(normalizeUid(uid));
            isProcessing = false;
        }

        async function loadDrinks() {
            try {
                const r = await fetch(API + '/drinks', { headers: {'Authorization': 'Bearer ' + token} });
                if (r.ok) drinks = await r.json();
            } catch(err) { console.error('Error loading drinks:', err); }
        }

        async function loadServedCount() {
            try {
                const r = await fetch(API + '/wristbands', { headers: {'Authorization': 'Bearer ' + token} });
                if (r.ok) {
                    const bands = await r.json();
                    const total = bands.reduce((s, b) => s + (parseFloat(b.credits_spent) || 0), 0);
                    servedCount = Math.floor(total / 7);
                    updateCount();
                }
            } catch(err) { updateCount(); }
        }

        function updateCount() {
            document.getElementById('servedCount').textContent = servedCount + ' Served';
        }

        async function lookupWristband(uid) {
            try {
                const r = await fetch(API + '/wristbands/rfid/' + encodeURIComponent(uid), {
                    headers: {'Authorization': 'Bearer ' + token}
                });
                if (!r.ok) { showMessage('❌ Wristband not found', 'error'); return; }
                const band = await r.json();
                currentBand = band;
                recentTransactions = [];
                displayCustomer(band);
            } catch(err) {
                showMessage('❌ Error looking up wristband', 'error');
            }
        }

        function displayCustomer(band) {
            document.getElementById('customerNameDisplay').textContent = band.customer_name || 'Customer';
            document.getElementById('wristbandDisplay').textContent = 'Wristband: ' + band.rfid_uid;

            const ageEl = document.getElementById('ageStatus');
            if (band.alcohol_approved) {
                ageEl.innerHTML = '<span class="age-badge age-ok">✓ 19+ VERIFIED</span>';
            } else {
                ageEl.innerHTML = '<span class="age-badge age-no">✗ NOT VERIFIED</span>';
            }

            const tickets = Math.floor(parseFloat(band.credits || 0) / 7);
            const balEl = document.getElementById('balanceAmount');
            balEl.textContent = tickets;
            balEl.style.color = tickets === 0 ? '#ef4444' : tickets <= 2 ? '#f59e0b' : '#00B74A';

            displayTransactions();
            renderDrinks(band);

            document.getElementById('scanCard').classList.add('hidden');
            document.getElementById('customerCard').classList.remove('hidden');
            stopNFC();
        }

        function renderDrinks(band) {
            const grid = document.getElementById('drinkGrid');
            grid.innerHTML = '';
            const balance = parseFloat(band.credits || 0);

            if (!band.alcohol_approved) {
                grid.innerHTML = '<div class="no-drinks">⚠️ Age verification required before serving drinks</div>';
                return;
            }
            if (balance < 7) {
                grid.innerHTML = '<div class="no-drinks">⚠️ No tickets — customer needs to purchase more</div>';
                return;
            }

            drinks.forEach(drink => {
                const btn = document.createElement('button');
                btn.className = 'drink-btn';
                const count = recentTransactions.filter(t => t.drink === drink.name).length;
                const outOfStock = drink.stock_remaining < 1;
                const noFunds = balance < parseFloat(drink.price);

                if (outOfStock) {
                    btn.disabled = true;
                    btn.innerHTML = `<span class="drink-name">${drink.name}</span><span style="font-size:12px;opacity:0.6;">OUT OF STOCK</span>`;
                } else if (noFunds) {
                    btn.disabled = true;
                    btn.innerHTML = `<span class="drink-name">${drink.name}</span>`;
                } else {
                    if (count > 0) btn.innerHTML += `<div class="drink-counter">${count}</div>`;
                    btn.innerHTML += `<span class="drink-name">${drink.name}</span>`;
                    btn.onclick = () => serveDrink(drink);
                }
                grid.appendChild(btn);
            });
        }

        function displayTransactions() {
            const container = document.getElementById('transactionsContainer');
            const list = document.getElementById('transactionsList');
            if (recentTransactions.length === 0) { container.classList.add('hidden'); return; }
            container.classList.remove('hidden');
            list.innerHTML = recentTransactions.map(t => `
                <div class="transaction-item">
                    <div class="transaction-info">
                        <strong>${t.drink}</strong>
                        <div class="transaction-time">${t.time}</div>
                    </div>
                    <button class="btn-cancel" onclick="cancelDrink('${t.id}')">Cancel</button>
                </div>
            `).join('');
        }

        async function serveDrink(drink) {
            if (isProcessing) return;
            isProcessing = true;
            try {
                const r = await fetch(API + '/drinks/serve', {
                    method: 'POST',
                    headers: {'Authorization': 'Bearer ' + token, 'Content-Type': 'application/json'},
                    body: JSON.stringify({ rfid_uid: normalizeUid(currentBand.rfid_uid), drink_id: drink.id })
                });
                const d = await r.json();
                if (r.ok) {
                    currentBand.credits = d.new_balance;
                    const remaining = Math.floor(d.new_balance / 7);
                    showMessage(`✅ ${drink.name} served! ${remaining} ticket${remaining !== 1 ? 's' : ''} left`, 'success');
                    recentTransactions.unshift({
                        id: 'trans_' + Date.now(), drink: drink.name, drink_id: drink.id,
                        time: new Date().toLocaleTimeString('en-CA', {hour: '2-digit', minute: '2-digit'})
                    });
                    if (recentTransactions.length > 5) recentTransactions = recentTransactions.slice(0, 5);
                    servedCount++;
                    updateCount();
                    await loadDrinks();
                    displayCustomer(currentBand);
                } else {
                    showMessage('❌ ' + d.error, 'error');
                }
            } catch(err) {
                showMessage('❌ Error serving drink', 'error');
            } finally {
                isProcessing = false;
            }
        }

        async function cancelDrink(transId) {
            const trans = recentTransactions.find(t => t.id === transId);
            if (!trans) return;
            try {
                const r = await fetch(API + '/wristbands/cancel-drink', {
                    method: 'POST',
                    headers: {'Authorization': 'Bearer ' + token, 'Content-Type': 'application/json'},
                    body: JSON.stringify({ rfid_uid: normalizeUid(currentBand.rfid_uid) })
                });
                const d = await r.json();
                if (r.ok) {
                    const refreshR = await fetch(API + '/wristbands/rfid/' + normalizeUid(currentBand.rfid_uid), {
                        headers: {'Authorization': 'Bearer ' + token}
                    });
                    if (refreshR.ok) currentBand = await refreshR.json();
                    recentTransactions = recentTransactions.filter(t => t.id !== transId);
                    servedCount = Math.max(0, servedCount - 1);
                    updateCount();
                    showMessage(`✅ ${trans.drink} cancelled — 1 ticket returned`, 'success');
                    await loadDrinks();
                    displayCustomer(currentBand);
                } else {
                    showMessage('❌ Cancel failed: ' + d.error, 'error');
                }
            } catch(err) {
                showMessage('❌ Error cancelling drink', 'error');
            }
        }

        function reset() {
            currentBand = null;
            recentTransactions = [];
            isProcessing = false;
            document.getElementById('scanCard').classList.remove('hidden');
            document.getElementById('customerCard').classList.add('hidden');
            document.getElementById('customerName').value = '';
            document.getElementById('searchResults').classList.add('hidden');
            clearMessage();
            if (currentMode === 'nfc') setTimeout(() => startNFC(), 100);
            else document.getElementById('customerName').focus();
        }

        function showMessage(msg, type) {
            document.getElementById('alertContainer').innerHTML = `<div class="alert alert-${type}">${msg}</div>`;
            if (type === 'success') setTimeout(clearMessage, 3000);
        }

        function clearMessage() { document.getElementById('alertContainer').innerHTML = ''; }
    </script>
</body>
</html>
