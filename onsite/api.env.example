# .env for rodeo-fresh running on the on-site NUC
# Copy to C:\rodeo\rodeo-fresh\.env and fill in the two secrets.

# Local PostgreSQL (installed on the NUC, see NUC-SETUP.md step 3)
DATABASE_URL=postgresql://postgres:YOUR_PG_PASSWORD@localhost:5432/rodeo_db

# IMPORTANT: use the SAME value as the Railway production deployment.
# Staff who logged in against production stay logged in when the site
# switches to the NUC (and vice versa). Copy it from Railway →
# rodeo-fresh service → Variables → JWT_SECRET.
JWT_SECRET=copy-from-railway

# Keep NODE_ENV unset (or "development") so config/database.js skips SSL —
# the local Postgres connection is plain localhost TCP.

PORT=3000
